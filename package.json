{
  "name": "chesslab-state",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/tui.ts",
    "demo": "node src/tui.ts --demo",
    "test": "node --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "debug": "node src/tui.ts --debug",
    "replay": "node src/tui.ts --replay",
    "sequence": "node src/tui.ts --replay --sequence",
